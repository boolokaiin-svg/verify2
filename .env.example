# ==============================================================
# Property Verification Agent - Environment Configuration
# ==============================================================

# 1. OpenRouter API Key (Required for Bilingual OCR, Captcha Solver & Legal Narration)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 2. AI Model Selection (Recommended: google/gemini-3.1-flash-lite)
OCR_MODEL=google/gemini-3.1-flash-lite
CAPTCHA_MODEL=google/gemini-3.1-flash-lite
REPORT_MODEL=google/gemini-3.1-flash-lite

# 3. TNREGINET Citizen Portal Credentials (Required for automated EC search & download)
TNREGINET_USERNAME=your_tnreginet_username
TNREGINET_PASSWORD=your_tnreginet_password

# 4. Portal Execution Mode (Render 512MB RAM Optimization)
# Options:
#   - 'http' (RECOMMENDED for Render): Uses zero-browser HTTP client (< 25MB RAM, 0MB Chromium disk).
#   - 'remote_browser': Connects to external Chromium via BROWSER_WS_ENDPOINT (0MB local RAM).
#   - 'local_browser': Launches local Playwright Chromium (requires >= 2GB RAM server).
PORTAL_MODE=http

# 5. Remote Browser Endpoint (Optional - e.g. Browserless.io)
# If set, connects to remote Chrome over WebSocket without running local Chromium.
# Example: wss://chrome.browserless.io?token=YOUR_BROWSERLESS_API_TOKEN
BROWSER_WS_ENDPOINT=

# 6. Concurrency & Performance
# Concurrency limit for OCR page batches (set to 2 for Render 512MB limit)
OCR_MAX_WORKERS=2

# 7. Optional: Alternative Direct Gemini API Key (if not using OpenRouter)
GEMINI_API_KEY=

# Shared backend-to-agent credential; use the same value on both services.
VERIFICATION_SERVICE_TOKEN=
# Optional persistent storage mount for certificates.
# VERIFICATION_STORAGE_DIR=/var/data/verification
